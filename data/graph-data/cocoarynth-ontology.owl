<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xml:base="urn:ontology:cocoarynth">
  <owl:Ontology rdf:about="urn:ontology:cocoarynth">
    <owl:versionInfo>v1 sha256:c7cc130cd425cd4099fe95d6207fcf20a85be36e500f9878126522626200bef9</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Batch">
    <rdfs:label>Batch</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>One production run whose code is printed on the wrapper as its lot code; not a bean lot.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#BatchInput">
    <rdfs:label>BatchInput</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A measured quantity of one bean lot used in one batch.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#BeanLot">
    <rdfs:label>BeanLot</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A quantity of beans shipped and received together; may supply several production batches.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Case">
    <rdfs:label>Case</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A retailer complaint, customer inquiry, or nonconformance record.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#CaseInvestigation">
    <rdfs:label>CaseInvestigation</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A dated investigation statement recorded within a case.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#CertificationRecord">
    <rdfs:label>CertificationRecord</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A supplier certification status record, including expired or explicitly absent certification.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#CocoarynthEntity">
    <rdfs:label>CocoarynthEntity</rdfs:label>
    <rdfs:comment>An identified entity or recorded observation in the fictional Cocoarynth corpus.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#CollectionTicket">
    <rdfs:label>CollectionTicket</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A slip recording fresh beans delivered by a farm to a cooperative.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Consignment">
    <rdfs:label>Consignment</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>An inbound shipment of bean lots, distinct from an outbound shipment of bars.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Contract">
    <rdfs:label>Contract</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A recorded supplier buying agreement.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Department">
    <rdfs:label>Department</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A department within Cocoarynth.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#DepotStop">
    <rdfs:label>DepotStop</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>One shipment's recorded custody and storage interval at a depot.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Document">
    <rdfs:label>Document</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>One of the existing PDFs in the corpus manifest.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Farm">
    <rdfs:label>Farm</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>An identified cacao farm or estate parcel.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#FarmContribution">
    <rdfs:label>FarmContribution</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>One farm's contribution to a bean lot; wet and dried kilograms remain distinct.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Finding">
    <rdfs:label>Finding</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>An inspection finding with its recorded corrective action and status.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Inspection">
    <rdfs:label>Inspection</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A recorded farm inspection, certification inspection, or buyer visit.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Logger">
    <rdfs:label>Logger</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A named device recording temperature at a site.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#LotHold">
    <rdfs:label>LotHold</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A recorded restriction on using a bean lot pending resolution of a quality problem.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#MarketPriceObservation">
    <rdfs:label>MarketPriceObservation</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>The fictional commodity-price comparison for one year.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Organization">
    <rdfs:label>Organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>Cocoarynth or an organization with which it works.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Origin">
    <rdfs:label>Origin</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A sourcing region and supplier, potentially involving several farms.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Pallet">
    <rdfs:label>Pallet</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>An explicitly identified pallet in a shipment record.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#PanelSample">
    <rdfs:label>PanelSample</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>One assessed sample in a sensory panel; a bench sample need not be a production batch.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Partner">
    <rdfs:label>Partner</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#Organization"/>
    <rdfs:comment>An importer, forwarder, carrier, laboratory, certifier, or other business partner.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Person">
    <rdfs:label>Person</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A named fictional person in the corpus; not a customer-facing disclosure permission.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#PolicyRecord">
    <rdfs:label>PolicyRecord</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>Structured receiving limits, storage guidance, or production parameters from the world data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#PriceObservation">
    <rdfs:label>PriceObservation</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>An origin's landed bean cost per kilogram for one year.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Product">
    <rdfs:label>Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A bar formulation or sellable product, distinct from one production run.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#PurchaseObservation">
    <rdfs:label>PurchaseObservation</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>Recorded purchases from one origin for one year.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#QualityTest">
    <rdfs:label>QualityTest</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A dated moisture, cut-test, or sensory check of a bean lot.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Retailer">
    <rdfs:label>Retailer</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#Organization"/>
    <rdfs:comment>An organization buying bars from Cocoarynth; includes its overseas distributor.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#SalesObservation">
    <rdfs:label>SalesObservation</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>Monthly product sell-in to one retailer, not consumer sell-through.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#SensoryPanel">
    <rdfs:label>SensoryPanel</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A recorded tasting panel with an assessment method and coordinator.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Shipment">
    <rdfs:label>Shipment</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>An outbound shipment of finished bars to a retailer.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#ShipmentLine">
    <rdfs:label>ShipmentLine</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A quantity of bars from one batch in an outbound shipment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Site">
    <rdfs:label>Site</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>A named facility or sublocation, such as a factory, room, depot, or storage bay.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#Supplier">
    <rdfs:label>Supplier</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#Organization"/>
    <rdfs:comment>A cooperative, producer association, or estate supplying cacao.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth#TemperatureReading">
    <rdfs:label>TemperatureReading</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:ontology:cocoarynth#CocoarynthEntity"/>
    <rdfs:comment>One temperature observation at the logger's explicitly recorded offset.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#assignedTo">
    <rdfs:label>assignedTo</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Person"/>
    <rdfs:comment>The explicitly recorded assignedTo relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#carriedBy">
    <rdfs:label>carriedBy</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Shipment"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Partner"/>
    <rdfs:comment>The explicitly recorded carriedBy relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#caseRetailer">
    <rdfs:label>caseRetailer</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Retailer"/>
    <rdfs:comment>The explicitly recorded caseRetailer relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#caseSupplier">
    <rdfs:label>caseSupplier</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Supplier"/>
    <rdfs:comment>The explicitly recorded caseSupplier relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#certificationFor">
    <rdfs:label>certificationFor</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#CertificationRecord"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Supplier"/>
    <rdfs:comment>The explicitly recorded certificationFor relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#certifiedBy">
    <rdfs:label>certifiedBy</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#CertificationRecord"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Partner"/>
    <rdfs:comment>The certification record names this certifier. CertificationRecord existence does not imply a valid certificate.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#collectedFrom">
    <rdfs:label>collectedFrom</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#CollectionTicket"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Farm"/>
    <rdfs:comment>The explicitly recorded collectedFrom relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#collectedInto">
    <rdfs:label>collectedInto</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#CollectionTicket"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#BeanLot"/>
    <rdfs:comment>The explicitly recorded collectedInto relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#concernsBatch">
    <rdfs:label>concernsBatch</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Batch"/>
    <rdfs:comment>The explicitly recorded concernsBatch relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#concernsFarm">
    <rdfs:label>concernsFarm</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Finding"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Farm"/>
    <rdfs:comment>The explicitly recorded concernsFarm relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#concernsLot">
    <rdfs:label>concernsLot</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#BeanLot"/>
    <rdfs:comment>The explicitly recorded concernsLot relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#concernsShipment">
    <rdfs:label>concernsShipment</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Shipment"/>
    <rdfs:comment>The explicitly recorded concernsShipment relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#contactPerson">
    <rdfs:label>contactPerson</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Organization"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Person"/>
    <rdfs:comment>The explicitly recorded contactPerson relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#containsLot">
    <rdfs:label>containsLot</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Consignment"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#BeanLot"/>
    <rdfs:comment>The explicitly recorded containsLot relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#contractSupplier">
    <rdfs:label>contractSupplier</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Contract"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Supplier"/>
    <rdfs:comment>The explicitly recorded contractSupplier relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#contributedTo">
    <rdfs:label>contributedTo</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Farm"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#BeanLot"/>
    <rdfs:comment>The farm is an explicit contribution to this bean lot; quantities and wet/dried units live on FarmContribution.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#contributionFrom">
    <rdfs:label>contributionFrom</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#FarmContribution"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Farm"/>
    <rdfs:comment>The explicitly recorded contributionFrom relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#coordinatedBy">
    <rdfs:label>coordinatedBy</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#SensoryPanel"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Person"/>
    <rdfs:comment>The explicitly recorded coordinatedBy relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#delayedByHold">
    <rdfs:label>delayedByHold</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Product"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#LotHold"/>
    <rdfs:comment>The product's launch_delay_reason explicitly identifies the held bean lot.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#deliveredTo">
    <rdfs:label>deliveredTo</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Shipment"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Retailer"/>
    <rdfs:comment>The explicitly recorded deliveredTo relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#farmedBy">
    <rdfs:label>farmedBy</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Farm"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Person"/>
    <rdfs:comment>The explicitly recorded farmedBy relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#forwardedBy">
    <rdfs:label>forwardedBy</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Consignment"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Partner"/>
    <rdfs:comment>The explicitly recorded forwardedBy relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasContribution">
    <rdfs:label>hasContribution</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#BeanLot"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#FarmContribution"/>
    <rdfs:comment>The explicitly recorded hasContribution relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasDepartment">
    <rdfs:label>hasDepartment</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Organization"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Department"/>
    <rdfs:comment>The explicitly recorded hasDepartment relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasDepotStop">
    <rdfs:label>hasDepotStop</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Shipment"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#DepotStop"/>
    <rdfs:comment>The explicitly recorded hasDepotStop relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasFinding">
    <rdfs:label>hasFinding</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Inspection"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#Finding"/>
    <rdfs:comment>The explicitly recorded hasFinding relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasHold">
    <rdfs:label>hasHold</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#BeanLot"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#LotHold"/>
    <rdfs:comment>The explicitly recorded hasHold relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasInput">
    <rdfs:label>hasInput</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Batch"/>
    <rdfs:range rdf:resource="urn:ontology:cocoarynth#BatchInput"/>
    <rdfs:comment>The explicitly recorded hasInput relationship.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth#hasInvestigation">
    <rdfs:label>hasInvestigation</rdfs:label>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth#Case"/>
