      "urn:ontology:cocoarynth#hasEvidenceSubmitted": [
        {
          "@value": "2026-08-28",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasCorrectiveAction": [
        {
          "@value": "Plant a 10 m buffer with a living Inga hedge along the east boundary and record neighbor spraying dates.",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasText": [
        {
          "@value": "Buffer strip between the cacao and the neighbor's rice paddy is only 3 m wide with no barrier hedge; the neighbor sprays herbicide by backpack sprayer. Required minimum is 8 m with a barrier.",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasFarm": [
        {
          "@value": "los-laureles",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasStatus": [
        {
          "@value": "evidence_submitted",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@value": "f-nh-01",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
