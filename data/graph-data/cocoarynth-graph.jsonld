        }
      ]
    },
    {
      "@id": "urn:cocoarynth:CaseInvestigation:CASE-2607-18:investigation:2",
      "@type": "urn:ontology:cocoarynth#CaseInvestigation",
      "urn:ontology:cocoarynth#hasDate": [
        {
          "@value": "2026-07-21",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasBy": [
        {
          "@value": "sam-okafor",
