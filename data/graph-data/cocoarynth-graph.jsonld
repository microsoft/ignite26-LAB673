        }
      ]
    },
    {
      "@id": "urn:cocoarynth:Finding:f-lv-01",
      "@type": "urn:ontology:cocoarynth#Finding",
      "urn:ontology:cocoarynth#hasClosed": [
        {
          "@value": "2026-08-12",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasDue": [
        {
          "@value": "2026-08-15",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#concernsFarm": [
        {
          "@id": "urn:cocoarynth:Farm:el-guayabo"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@value": "f-lv-01",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasText": [
        {
          "@value": "After two weeks of rain the farm installed a wood-fired dryer. Its chimney stands about 4 m from the drying racks and smoke drifts over the beans in the afternoon.",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasIdentifier": [
        {
          "@value": "f-lv-01",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasSeverity": [
        {
          "@value": "major",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasFarm": [
        {
          "@value": "el-guayabo",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasStatus": [
        {
          "@value": "closed",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasCorrectiveAction": [
        {
          "@value": "Move the drying racks at least 30 m upwind of the dryer and extend the chimney above the roofline.",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ]
    },
    {
      "@id": "urn:cocoarynth:Finding:f-nh-01",
      "@type": "urn:ontology:cocoarynth#Finding",
      "urn:ontology:cocoarynth#hasFollowUpVisit": [
        {
          "@value": "2026-10-20",
