        }
      ],
      "urn:ontology:cocoarynth#investigatedBy": [
        {
          "@id": "urn:cocoarynth:Person:sam-okafor"
        }
      ],
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@value": "CASE-2607-18:investigation:2",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasFindingText": [
        {
          "@value": "Northwind's depot log shows pallet LM-P02 spent 12 hours in Overflow Bay 4 on 14 July. LOGGER-04 shows air above 25 \u00b0C from 11:30 to 17:30, peaking at 34.1 \u00b0C at 14:30.",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ]
    },
