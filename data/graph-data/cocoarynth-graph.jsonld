    {
      "@id": "urn:cocoarynth:CaseInvestigation:CASE-2607-18:investigation:1",
      "@type": "urn:ontology:cocoarynth#CaseInvestigation",
      "http://www.w3.org/2000/01/rdf-schema#label": [
        {
          "@value": "CASE-2607-18:investigation:1",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#hasFindingText": [
        {
          "@value": "Steeple & Saucer (600 bars) and Pantry Lane (300 bars) received the same batch on direct routes; neither reported bloom.",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      ],
      "urn:ontology:cocoarynth#investigatedBy": [
        {
          "@id": "urn:cocoarynth:Person:sam-okafor"
        }
      ],
