<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="urn:ontology:cocoarynth-navigation#">
    <rdfs:comment>Navigation schema for the preserved computed topic hierarchy and original PDF passages. Topic similarity and membership are not business relationships.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="urn:ontology:cocoarynth-navigation#Topic">
    <rdfs:label>Topic</rdfs:label>
    <rdfs:comment>A computed community of similar PDF passages.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth-navigation#Document">
    <rdfs:label>Document</rdfs:label>
    <rdfs:comment>An original Cocoarynth PDF.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:ontology:cocoarynth-navigation#TextChunk">
    <rdfs:label>TextChunk</rdfs:label>
    <rdfs:comment>A captured passage from an original PDF.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth-navigation#hasSubtopic">
    <rdfs:label>hasSubtopic</rdfs:label>
    <rdfs:comment>The preserved computed parent-to-child community link.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth-navigation#Topic" />
    <rdfs:range rdf:resource="urn:ontology:cocoarynth-navigation#Topic" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth-navigation#hasMember">
    <rdfs:label>hasMember</rdfs:label>
    <rdfs:comment>The preserved computed membership of a PDF passage in a topic.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth-navigation#Topic" />
    <rdfs:range rdf:resource="urn:ontology:cocoarynth-navigation#TextChunk" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:ontology:cocoarynth-navigation#hasTextChunk">
    <rdfs:label>hasTextChunk</rdfs:label>
    <rdfs:comment>Connects an original PDF to its captured passage.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth-navigation#Document" />
    <rdfs:range rdf:resource="urn:ontology:cocoarynth-navigation#TextChunk" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="urn:ontology:cocoarynth-navigation#description">
    <rdfs:label>description</rdfs:label>
    <rdfs:comment>A display description generated from the topic's fixed member passages.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth-navigation#Topic" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:ontology:cocoarynth-navigation#chunkId">
    <rdfs:label>chunkId</rdfs:label>
    <rdfs:comment>The exact document key in the cocoarynth-chunks index.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth-navigation#TextChunk" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:ontology:cocoarynth-navigation#path">
    <rdfs:label>path</rdfs:label>
    <rdfs:comment>The original PDF's portable citation path.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:ontology:cocoarynth-navigation#Document" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
</rdf:RDF>
