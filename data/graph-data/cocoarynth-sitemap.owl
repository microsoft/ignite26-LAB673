<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="urn:topicgraph:ontology#">
    <rdfs:comment>Canonical TopicGraph navigation schema. Chunks remain in the source index and are retrieved by centroid search, not by stored membership edges. The business ontology and extraction are unchanged.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="urn:topicgraph:ontology#Vector">
    <rdfs:label>Vector</rdfs:label>
    <rdfs:comment>A centroid embedding attached to a leaf community for vector retrieval.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:topicgraph:ontology#CommunityGraph">
    <rdfs:label>CommunityGraph</rdfs:label>
    <rdfs:comment>The community graph as a whole: entry point to its roots and holder of graph-wide metadata. One per index.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="urn:topicgraph:ontology#Community">
    <rdfs:label>Community</rdfs:label>
    <rdfs:comment>A community of chunks. A parent community has one or more sub-communities, which never overlap and together cover its chunks.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="urn:topicgraph:ontology#HasRootCommunity">
    <rdfs:label>HasRootCommunity</rdfs:label>
    <rdfs:comment>Connects the graph to a top-level community.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#CommunityGraph" />
    <rdfs:range rdf:resource="urn:topicgraph:ontology#Community" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="urn:topicgraph:ontology#HasSubCommunity">
    <rdfs:label>HasSubCommunity</rdfs:label>
    <rdfs:comment>Connects a parent community to a direct child.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="urn:topicgraph:ontology#Community" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#generatedAt">
    <rdfs:label>generatedAt</rdfs:label>
    <rdfs:comment>When the graph payload was built, in UTC.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#CommunityGraph" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#version">
    <rdfs:label>version</rdfs:label>
    <rdfs:comment>Numeric version of the tool that built the community graph.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#CommunityGraph" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#buildDuration">
    <rdfs:label>buildDuration</rdfs:label>
    <rdfs:comment>Wall-clock seconds used to build the community graph.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#CommunityGraph" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#numQueries">
    <rdfs:label>numQueries</rdfs:label>
    <rdfs:comment>Number of model queries used to build the community graph.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#CommunityGraph" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#title">
    <rdfs:label>title</rdfs:label>
    <rdfs:comment>A short, human-readable community title.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#description">
    <rdfs:label>description</rdfs:label>
    <rdfs:comment>A summary of the community's content.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#level">
    <rdfs:label>level</rdfs:label>
    <rdfs:comment>Depth in the community hierarchy; roots have level 0.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#proportion">
    <rdfs:label>proportion</rdfs:label>
    <rdfs:comment>Community chunk count divided by all represented chunks.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="urn:topicgraph:ontology#parentProportion">
    <rdfs:label>parentProportion</rdfs:label>
    <rdfs:comment>Community chunk count divided by its parent's chunk count. For roots, equal to proportion.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="urn:topicgraph:ontology#HasCentroidVector">
    <rdfs:label>HasCentroidVector</rdfs:label>
    <rdfs:comment>Centroid embedding for vector retrieval; emitted only for leaf communities.</rdfs:comment>
    <rdfs:domain rdf:resource="urn:topicgraph:ontology#Community" />
    <rdfs:range rdf:resource="urn:topicgraph:ontology#Vector" />
  </owl:ObjectProperty>
</rdf:RDF>
