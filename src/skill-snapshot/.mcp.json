{
  "mcpServers": {
    "azure": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "env": {
        "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org/"
      }
    },
    "ekg-skills": {
      "command": "uv",
      "args": [
        "--directory",
        "/",
        "tool",
        "run",
        "--isolated",
        "--from",
        "${CLAUDE_PLUGIN_ROOT}/runtime/ekg-skills[apps,consume]",
        "ekg-apps"
      ],
      "env": {
        "UV_INDEX_URL": "https://pypi.org/simple/"
      }
    },
    "grz-skills": {
      "command": "uv",
      "args": [
        "--directory",
        "/",
        "tool",
        "run",
        "--isolated",
        "--python",
        "3.12",
        "--from",
        "${CLAUDE_PLUGIN_ROOT}/runtime/grz-skills[azure,embed,apps]",
        "grz-mcp"
      ],
      "env": {
        "UV_INDEX_URL": "https://pypi.org/simple/"
      }
    }
  }
}
