AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/
AZURE_OPENAI_KEY=your-foundry-api-key
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_CHATGPT_MODEL_NAME=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_TENANT_ID=your-tenant-id
MICROSOFT_FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project-name
MICROSOFT_FOUNDRY_PROJECT_ID=/subscriptions/your-subscription/resourceGroups/your-resource-group/providers/Microsoft.CognitiveServices/accounts/your-foundry-resource/projects/your-project-name
INDEXING_STORAGE_ACCOUNT_ID=/subscriptions/your-subscription/resourceGroups/your-resource-group/providers/Microsoft.Storage/storageAccounts/your-storage-account
INDEXING_STORAGE_ACCOUNT_NAME=your-storage-account
CONTENTUNDERSTANDING_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
CONTENTUNDERSTANDING_KEY=your-foundry-api-key
CONTENTUNDERSTANDING_API_VERSION=2025-11-01
RESTORE_INDEX_SNAPSHOTS=true

# Optional REST preview notebooks: use a prepared, feature-enabled Search service.
# Exported environment variables override .env in these notebooks.
AZURE_SEARCH_PREVIEW_ENDPOINT=https://your-preview-search-service.search.windows.net
AZURE_SEARCH_PREVIEW_ADMIN_KEY=your-preview-search-admin-key
AZURE_SEARCH_PREVIEW_RESOURCE_PREFIX=lab673-your-unique-suffix
AZURE_SEARCH_PREVIEW_INDEX_PREFIX=lab673-preview-cocoarynth

# Three-notebook SDK lab: use the main Search endpoint/key above for every part.
# The graph loader and all notebooks must target that same prepared service.
AZURE_SEARCH_LAB_RESOURCE_PREFIX=lab673-your-unique-suffix
AZURE_SEARCH_CONTENT_INDEX_PREFIX=cocoarynth
# Match restore-graph-indexes.py --prefix exactly; leave empty without --prefix.
AZURE_SEARCH_GRAPH_INDEX_PREFIX=